# Local development (synthetic data only)
ABA_MODE=local
DATABASE_URL=postgres://aba_app:aba_app_local@127.0.0.1:5432/aba
MIGRATION_DATABASE_URL=postgres://aba_owner:aba_owner_local@127.0.0.1:5432/aba
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_IDLE_MINUTES=15
APP_URL=http://localhost:3000
# Optional: text the local "transcriber" returns, for demos without Amazon Transcribe
# LOCAL_TRANSCRIPT=Aggression decreased to 1.2 per hour across the last four weeks.

# AWS mode (set by CDK/ECS task definition; secrets come from Secrets Manager)
# ABA_MODE=aws
# AWS_REGION=us-east-1
# FILES_BUCKET=...
# JOBS_QUEUE_URL=...
# COGNITO_USER_POOL_ID=...
# COGNITO_CLIENT_ID=...
# TRANSCRIBE_VOCABULARY=aba-terms
