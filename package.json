{
  "name": "aba-plan-assistant",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:up": "bash scripts/local-db.sh start",
    "db:down": "bash scripts/local-db.sh stop",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "fixtures": "tsx scripts/make-fake-pdfs.ts",
    "dev": "pnpm --filter @aba/web dev",
    "worker": "pnpm --filter @aba/worker start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "audit:deps": "pnpm audit --audit-level high",
    "cdk:synth": "pnpm --filter @aba/infra synth",
    "cdk:deploy:dev": "pnpm --filter @aba/infra deploy:dev",
    "totp": "tsx scripts/totp.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.31",
      "vite": ">=6.4.4",
      "tinypool": ">=2.1.2"
    }
  }
}